{
  "expo": {
    "name": "糍粑英语",
    "slug": "ciba-english",
    "version": "1.1.1",
    "scheme": "cibaenglish",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yugusoft.CibaEnglish.category",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "weixin",
            "CFBundleURLSchemes": [
              "wx97f824fd700ab212",
              "cibaenglish"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "weixin",
          "weixinULAPI"
        ]
      }
    },
    "android": {
      "package": "com.cibaenglish.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#F8FBFC"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-apple-authentication",
      "react-native-iap"
    ],
    "extra": {
      "eas": {
        "projectId": "aa18246f-2123-4e53-ba40-36f7f1eeb68f"
      }
    },
    "owner": "meliushuangs-team"
  }
}
