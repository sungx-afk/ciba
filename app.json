{
  "expo": {
    "name": "糍粑英语",
    "slug": "ciba-english",
    "version": "1.0.7",
    "scheme": "cibaenglish",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./src/assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFAF4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cibaenglish.app",
      "buildNumber": "8",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "weixin",
            "CFBundleURLSchemes": [
              "wx97f824fd700ab212",
              "cibaenglish"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "weixin",
          "weixinULAPI"
        ]
      }
    },
    "android": {
      "package": "com.cibaenglish.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FDFAF4"
      }
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-apple-authentication"
    ]
  }
}
